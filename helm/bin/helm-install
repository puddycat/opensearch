#! /usr/bin/env bash
#
# opensearch/bin/helm-install
#
# raymondstrose@hotmail.com
#
#   Install a Elasticsearch HELM chart.
#

append () { sed -e "s?\$?$@?"; }
prepend () { sed -e "s?^?$@?"; }
indent () { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "    "; }
error () { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: error: " >&2; }
warning () { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: warning: " >&2; }
notice () { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: notice: " >&2; }
info () { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: info: " >&2; }
verbose () { $VERBOSE_MODE && { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: verbose: " >&2; } }
debug () { $DEBUG_MODE && { { if [ $# -ne 0 ]; then echo -e "$@"; else cat; fi; } | prepend "$PROGNAME: debug: " >&2; } }

function execute ()
{
	declare -a params;

	for param; do
		if [[ -z "${param}" || "${param}" =~ [^A-Za-z0-9_@%+=:,./-] ]]; then
			params+=("'${param//\'/\'\"\'\"\'}'");
		else
			params+=("${param}");
		fi;
	done;

	debug "${params[*]}";
	eval ${params[*]};
}

install ()
{
	HELM_VALUES="";

	if [ -f "$INSTALL_DIR/values.yaml" ]; then
		HELM_VALUES="--values $INSTALL_DIR/values.yaml";
	fi;

# Override values specified within the values.yaml file.
	HELM_SET_VALUES="";

	if [ "$WEB_PATH" ]; then
		HELM_SET_VALUES="--set ingress.hosts[0].paths[0].path=$WEB_PATH";
	fi;

	if $DEPLOYMENT_MODE; then
		HELM_SET_VALUES="--set service.enable_persistence=false $HELM_SET_VALUES";
	fi;

	if $STATEFUL_SET_MODE; then
		HELM_SET_VALUES="--set service.enable_persistence=true $HELM_SET_VALUES";
	fi;

	if $DISABLE_SECURITY; then
		HELM_SET_VALUES="--set security.enabled=false $HELM_SET_VALUES";
	else
		HELM_SET_VALUES="--set security.enabled=true $HELM_SET_VALUES";
		HELM_SET_VALUES="--set security.tls.restEncryption=true $HELM_SET_VALUES";
		HELM_SET_VALUES="--set security.tls.autoGenerated=true $HELM_SET_VALUES";
	fi;

	if [ "$IMAGE_PULL_POLICY" ]; then
		HELM_SET_VALUES="--set image.pullPolicy=$IMAGE_PULL_POLICY $HELM_SET_VALUES";
	fi;

	HELM_SET_VALUES="--set image.debug=true $HELM_SET_VALUES";

	HELM_SET_VALUES="--set master.startupProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set master.livenessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set master.readinessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";

	HELM_SET_VALUES="--set data.startupProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set data.livenessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set data.readinessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";

	HELM_SET_VALUES="--set ingest.startupProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set ingest.livenessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set ingest.readinessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";

	HELM_SET_VALUES="--set metrics.startupProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set metrics.livenessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";
	HELM_SET_VALUES="--set metrics.readinessProbe.enabled=$ENABLE_PROBES $HELM_SET_VALUES";

# Unpacked charts cannot be verified
	#HELM_VERIFY_MODE="--verify";
	HELM_VERIFY_MODE="";
	HELM_DEBUG_MODE="";
	$DEBUG_MODE && HELM_DEBUG_MODE="--debug";

	if $HELM_LINT_MODE; then
		execute helm lint --namespace $NAMESPACE_NAME	\
			$HELM_DEBUG_MODE	\
			$HELM_VALUES	\
			--with-subcharts	\
			$INSTALL_DIR || return $?;
	fi;

	execute helm install --namespace $NAMESPACE_NAME	\
		$HELM_DEBUG_MODE	\
		$HELM_VERIFY_MODE	\
		--dependency-update	\
		--dry-run	\
		--replace	\
		--create-namespace	\
		$RELEASE_NAME	\
		$INSTALL_DIR	\
		$HELM_SET_VALUES	\
		$HELM_VALUES || return $?;

	execute helm install --namespace $NAMESPACE_NAME	\
		$HELM_DEBUG_MODE	\
		$HELM_VERIFY_MODE	\
		--dependency-update	\
		--wait	\
		--wait-for-jobs	\
		--replace	\
		--create-namespace	\
		$RELEASE_NAME	\
		$INSTALL_DIR	\
		$HELM_SET_VALUES	\
		$HELM_VALUES || return $?;

	return 0;
}

remove ()
{
	execute helm uninstall --namespace=$NAMESPACE_NAME $RELEASE_NAME || return $?;
	return 0;
}

main ()
{
# Display usage information.
#
	usage ()
	{
		cat <<-EOF >&2
			$PROGNAME: usage: $PROGNAME [--help] [--debug] [--verbose] [--remove] [--noop] [--config-dir {path}] [--stateful-set|--deployment] [--namespace {name}] [--disable-security] [--image-pull-policy {name}] [--disable-probes]

			--disable-probes            Disable probes (master, ingest, data, metrics. default: $ENABLE_PROBES)
			--image-pull-policy {name}  Set the Elasticsearch image pull policy (Always or IfNotPresent. default: $IMAGE_PULL_POLICY)
			--disable-security          Disable Elasticsearch security(default: $DISABLE_SECURITY)
			--stateful-set              Deploy a stateful application (default: $STATEFUL_SET_MODE)
			--deployment                Deploy a stateless application (default: $DEPLOYMENT_MODE)
			--config-dir {path}         Specify the configuration directory (default: $CONFIG_DIR)
			--namespace {name}          Specify the namespace name (default: $NAMESPACE_NAME)
			--noop                      Don't perform the operation, just report the actions that would be carried out.
			--remove                    Remove the installation (default: $REMOVE_MODE)
			--verbose                   Enable verbose mode.
			--debug                     Enable debug mode.
			--help                      Display this usage information.
			EOF

		return 0;
	}

# Load configuration files.
#
	load_config ()
	{
		if [ "$CONFIG_DIR" ]; then
			if [ -d "$CONFIG_DIR" ]; then

			# Configure the process
			#
				notice "Loading configuration.";
				for filename in $CONFIG_DIR/*; do
					indent "$filename" | debug;
					[ -f "$filename" ] && { source "$filename" || return 1; }
				done;
			fi;
		fi;

		return 0;
	}

	export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/go/bin";
	export PROGNAME=$(basename "$0");
	export PROGDIR=$(dirname "$0");
	export INSTALL_DIR=$(dirname "$PROGDIR");
	export CONFIG_DIR="$INSTALL_DIR/etc/$PROGNAME";
	export LIB_DIR="$INSTALL_DIR/lib/$PROGNAME";
	export WORK_DIR="$INSTALL_DIR/var/$PROGNAME";
	export DEBUG_MODE=false;
	export VERBOSE_MODE=false;
	export NOOP_MODE=false;
	export IMAGE_PREFIX="";
	export IMAGE_NAME="opensearch";
	export IMAGE_TAG="14.5-alpine3.16";
	export USE_BUILDX=true;
	#export BUILDX_PLATFORMS="linux/amd64,linux/arm64,linux/riscv64,linux/ppc64le,linux/s390x,linux/386,linux/arm/v7,linux/arm/v6";
	export BUILDX_PLATFORMS="linux/amd64,linux/arm64,linux/arm/v7";
	export REMOVE_MODE=false;
	export NAMESPACE_NAME="opensearch";
	export STATEFUL_SET_MODE=false;
	export DEPLOYMENT_MODE=false;
	export CHART_NAME=$(awk '/^name: / { print $2; }' Chart.yaml);	# As defined in Chart.yaml
	export RELEASE_NAME="$CHART_NAME";
	export DISABLE_SECURITY=false;
	#export IMAGE_PULL_POLICY="Always";
	export IMAGE_PULL_POLICY="IfNotPresent";
	export ENABLE_PROBES="true";

# Load the default configuration files.
	load_config || return $?;

	while [ $# -gt 0 ]; do
		case "$1" in
		--image-pull-policy|--image-pull-policy=?*)
			case "$1" in
			--image-pull-policy)	IMAGE_PULL_POLICY="$2"; shift;;
			--image-pull-policy=?*)	IMAGE_PULL_POLICY="${1#--image-pull-policy=}";;
			esac;;
		--disable-security)	DISABLE_SECURITY=true;;
		--disable-probes)	ENABLE_PROBES=false;;
		--stateful-set)	STATEFUL_SET_MODE=true;;
		--deployment)	DEPLOYMENT_MODE=true;;
		--remove)    REMOVE_MODE=true;;
		--namespace|--namespace=?*)
			case "$1" in
			--namespace)	NAMESPACE_NAME="$2"; shift;;
			--namespace=?*)	NAMESPACE_NAME="${1#--namespace=}";;
			esac;;
		--image-name|--image-name=?*)
			case "$1" in
			--image-name)		IMAGE_NAME="$2"; shift;;
			--image-name=?*)	IMAGE_NAME="${1#--image-name=}";;
			esac;;
		--image-tag|--image-tag=?*)
			case "$1" in
			--image-tag)	IMAGE_TAG="$2"; shift;;
			--image-tag=?*)	IMAGE_TAG="${1#--image-tag=}";;
			esac;;
		--config-dir|--config-dir=?*)
			case "$1" in
			--config-dir)		CONFIG_DIR="$2"; shift;;
			--config-dir=?*)	CONFIG_DIR="${1#--config-dir=}";;
			esac;

		# Load the specified configuration files.
			load_config || return $?;;
		--debug)	$DEBUG_MODE && set -x; DEBUG_MODE=true;;
		--noop)		NOOP_MODE=true;;
		--verbose)	VERBOSE_MODE=true;;
		--help) usage; return 2;;
		--) shift; break;;
		-*)	error "unknown option \"$1\""; usage; return 1;;
		*)	error "unrecognised command line argument \"$1\""; usage; return 1;;
		esac;

		shift;
	done;

	debug "$(env)";

	if $REMOVE_MODE; then
		remove || return $?;
	else
		install || return $?;
	fi;

	return 0;
}

	main "$@";
